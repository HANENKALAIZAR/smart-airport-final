# ── Smart Airport Operations – Environment Variables ─────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Application ──────────────────────────────────────────────────────────
APP_NAME=Smart Airport Operations
APP_VERSION=1.0.0
DEBUG=False

# ── Database (PostgreSQL) ────────────────────────────────────────────────
DB_USER=postgres
DB_PASS=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_airport

# ── JWT Authentication ───────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── External APIs ────────────────────────────────────────────────────────
# Get a key at: https://aviation-edge.com
AVIATION_EDGE_KEY=25178f-46404d

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────
# 1. Enable 2-Step Verification in your Google account
# 2. Go to: myaccount.google.com → Security → App Passwords
# 3. Create an App Password for "Mail" and paste the 16-char code below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password

# ── Frontend URL (used in welcome emails) ────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── CORS Origins ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── FlightAware AeroAPI (secondary enrichment provider) ────────────────
# Obtain a Personal plan key at: https://flightaware.com/commercial/aeroapi/
# Leave FLIGHTAWARE_API_KEY empty (or set FLIGHTAWARE_ENABLED=false) to
# completely disable FlightAware enrichment. The core Aviation Edge pipeline
# continues to work normally when FlightAware is disabled.
FLIGHTAWARE_API_KEY=Hz55SsXrt5LMWosYjoM2oOixyG7aJ0yF
FLIGHTAWARE_BASE_URL=https://aeroapi.flightaware.com/aeroapi
FLIGHTAWARE_ENABLED=true
FLIGHTAWARE_ENRICH_INTERVAL_MINUTES=15
FLIGHTAWARE_CACHE_TTL_SECONDS=180
FLIGHTAWARE_TIMEOUT_SECONDS=5.0
FLIGHTAWARE_WINDOW_PAST_HOURS=2
FLIGHTAWARE_WINDOW_FUTURE_HOURS=12
